@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find required dependencies
find_dependency(fmt REQUIRED)
find_dependency(OpenSSL REQUIRED)
find_dependency(boost REQUIRED)
find_dependency(protobuf REQUIRED)
find_dependency(spdlog REQUIRED)
find_dependency(rocksdb REQUIRED)
find_dependency(gtest REQUIRED)

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/TokiwaTargets.cmake")

# Set package properties
set(Tokiwa_VERSION "@Tokiwa_VERSION@")
set(Tokiwa_VERSION_MAJOR "@Tokiwa_VERSION_MAJOR@")
set(Tokiwa_VERSION_MINOR "@Tokiwa_VERSION_MINOR@")
set(Tokiwa_VERSION_PATCH "@Tokiwa_VERSION_PATCH@")

check_required_components(Tokiwa)
